# ---------------------------------------------------------------------------
# Infrastructure environment variables
# Copy this file to infra/.env and fill in the values.
# infra/.env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Cloudflare API token — requires Zone > DNS > Edit permission
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=""

# Cloudflare Zone ID — found on the domain Overview page (right sidebar)
CLOUDFLARE_ZONE_ID=""

# ---------------------------------------------------------------------------
# Cognito seed users
# ---------------------------------------------------------------------------

# Password for all seed test users created by seed-cognito.sh.
# Must meet Cognito complexity: min 8 chars, uppercase, lowercase, number, special char.
# Example: MyTestPass1!
COGNITO_SEED_PASSWORD=""
